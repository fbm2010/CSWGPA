# Google OAuth — get from https://console.cloud.google.com
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret_here
OAUTH_CALLBACK_URL=http://localhost:3000/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace_with_64_char_hex
SESSION_SECRET=replace_with_different_64_char_hex

# GPA Exclusion — comma separated, case insensitive
# Defaults cover Driver Ed, Drug & Alcohol, Homeroom, Study Hall
EXCLUDE_COURSES=drivers ed,driver's ed,drivers education,driver education,drug and alcohol,drug & alcohol,drug and alcohol education,drug and alcohol awareness,homeroom,study hall

# Autocomplete tuning
AUTOCOMPLETE_LIMIT=10
FUSE_THRESHOLD=0.35

# File storage
MAX_PDF_SIZE_MB=10
UPLOAD_DIR=./uploads
DB_PATH=./atlas_gpa.db

PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
