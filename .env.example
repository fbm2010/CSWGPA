# Google OAuth — get from https://console.cloud.google.com
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
OAUTH_CALLBACK_URL=http://localhost:3000/auth/google/callback
FRONTEND_URL=http://localhost:3000

# Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=generate-a-random-64-char-hex-string
SESSION_SECRET=generate-a-random-64-char-hex-string

# GPA Exclusion — comma separated, case insensitive
# Defaults cover Driver Ed, Drug & Alcohol, Homeroom, Study Hall
EXCLUDE_COURSES=drivers ed,driver's ed,drivers education,driver education,drug and alcohol,drug & alcohol,drug and alcohol education,drug and alcohol awareness,homeroom,study hall

# Autocomplete tuning
AUTOCOMPLETE_LIMIT=10
FUSE_THRESHOLD=0.35

# ── LiteParse local PDF parser (primary, no API key needed) ──────────────────
# Installed via: npm i @llamaindex/liteparse
# No configuration needed — works out of the box.

# ── Ollama AI PDF parser (optional, local fallback) ───────────────────────────
# Ollama must be running locally: https://ollama.com/download
#
# Recommended models by environment:
#   Codespaces (low CPU/RAM):     qwen2.5:0.5b (~400 MB) ollama pull qwen2.5:0.5b
#   Codespaces / low RAM (~8 GB): phi3:mini    (~2.2 GB) ollama pull phi3:mini
#   High-RAM machine (16+ GB):    llama3.2:3b  (~2 GB)   ollama pull llama3.2:3b
#
# Memory knobs (Codespaces-safe defaults shown):
#   OLLAMA_NUM_CTX   — KV-cache context window. 2048 uses ~500 MB; 4096 uses ~1.5 GB.
#   OLLAMA_NUM_PRED  — Max output tokens. 256 is enough for one JSON report card.
#   OLLAMA_MAX_CHARS — Hard cap on PDF text sent to model (keeps prompt inside ctx).
#   OLLAMA_NUM_THREAD— CPU inference threads. 2 avoids starving other processes.
#   OLLAMA_TIMEOUT   — ms to wait for a response before giving up (45 s default).
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT=45000
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PRED=256
OLLAMA_MAX_CHARS=2500
OLLAMA_NUM_THREAD=2

# File storage
MAX_PDF_SIZE_MB=10
UPLOAD_DIR=./uploads
DB_PATH=./atlas_gpa.db

PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
